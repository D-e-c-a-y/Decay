assignGuard() @
breakTest()
    for i=1 i<=10 i+=1 if i == 5 @ i # #
    @ 0
add(a, b) @ a + b
localTest() loc = 999 @ loc
readGlob() @ glob
shadow(xShadow) xShadow = 50 @ xShadow
fact(n)
    if n <= 1 @ 1 #
    @ n * fact(n-1)
modArr(a) push(a, 99) @ 
subFunc() tempVar = 50 @ tempVar
callerFunc()
    tempVar = 10
    trash = subFunc()
    @ tempVar 
oneLine(x) if x>0 @ 1 # @ 0
spaced ( x ) @ x    
gcd(a, b)
    if b == 0 @ a #
    mod = a - (b * floor(a/b))
    @ {gcd(b, mod)}
sumArr(arr)
    s = 0
    l = len(arr)
    for i=1 i<=l i+=1 s += arr[i] #
    @ s
fibIter(n)
    a = 0
    b = 1
    for i=1 i<n i+=1
        temp = a + b
        a = b
        b = temp
    #
    @ b
thrower(mode)
    if mode == 1 throw "Simple Error" #
    if mode == 2 throw [^code: 500, ^msg: "Complex Error"] #
    @
getPoint() @ [10, 20]
fib(n)
    if n < 2 return n #
    return fib(n-1) + fib(n-2)
unreachable()
    res = 100
    @ res res = 200

// --- NEW CLASS ADDITION ---

CLASS Hydra
    in(hp, dist, heads)
        self.hp = hp
        self.dist = dist
        self.heads = heads
    @ ~ Ends the constructor without returning

    think()
        res = neural brain
            [hp, dist, heads]
            
            [20, any, any] Panic
            [any, 10, any] Melee
            [80, 80, 5]    Barrage

            WITH [self.hp, self.dist, self.heads]
            limit 80

            case Panic    "Regenerating"
            case Melee    self.bite()
            case Barrage  "Fireball Storm"
            fallback      "Stalking"
        #
    @ res

    bite()
    @ "Crunch!"
**

CLASS BrainTest
    in(x, y)
        self.x = x
        self.y = y
    @

    ~ Tests Expression Mode and Local Persistence
    getSpeed(bonus)
        ~ Attach to 'self' so we can read the properties in the assert
        self.engine = neural math_brain
            [x, y]
            [10, any] Slow
            [any, 90] Fast
            WITH [self.x, self.y]
            limit 50
            case Slow 1
            case Fast 10
            fallback 0
        #
        @ bonus + self.engine.action
**

coexistFunc()
@ 99

testThrowPrimitive(val)
    caught = false
    errType = null
    hasLine = false
    try
        throw val
    err e
        caught = true
        errType = e[^type]
        hasLine = has(e[^msg], "at Line:")
    #
@ [caught, errType, hasLine]

nestedThrowCatch()
    res = []
    try
        try
            throw 101
        err e1
            push(res, e1[^msg])
            throw 202
        #
    err e2
        push(res, e2[^msg])
    #
@ res

downContinueSum()
    total = 0
    for i 10..1 i -= 2
        if i == 6 continue #
        total += i
    #
@ total

nestedRangeJump()
    count = 0
    for x 1..3
        for y 1..5
            if y == 2 continue #
            if y == 4 break #
            count += 1
        #
    #
@ count

trackEvalA(log)
    push(log, "A")
@ 10

trackEvalB(log)
    push(log, "B")
@ 20

trackSideEffect(log)
    push(log, "Inside")
@ "Returned"

