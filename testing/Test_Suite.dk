solverDeterministicTie()
    first = []
    second = []
    for i 1..5
        probe = solver
            [
                x: [1, 2],
                y: [1, 2]
            ]
            rules [
                x + y == 3
            ]
            optimize [
                [max: x + y]
            ]
        #
        push(first, probe.best.x)
        push(second, probe.best.y)
    #
    @ [first, second]

solverLimitProbe()
    probe = solver
        [
            a: [1, 2, 3],
            b: [1, 2, 3],
            c: [1, 2, 3]
        ]
        mode "all"
        limit 5
    #
    @ [probe.complete, probe.reason, probe.count, probe.solutions[1].a, probe.best.a]

solverFailureThenCleanSuccess()
    bad = captureRunError("probe = solver [x: 5] rules [x == 5] #")
    clean = passGuard("afterSolverFail = 12 if afterSolverFail != 12 solverDirty() #")
    @ [bad[1], bad[2], bad[3], clean]

solverTimeoutThenCleanSuccess()
    probe = solver
        [
            a: [1, 2, 3, 4],
            b: [1, 2, 3, 4],
            c: [1, 2, 3, 4],
            d: [1, 2, 3, 4]
        ]
        rules [
            a != b,
            b != c,
            c != d,
            a != d
        ]
        mode "all"
        timeout 0
    #
    clean = passGuard("afterSolverTimeout = 33 if afterSolverTimeout != 33 solverTimeoutDirty() #")
    @ [probe.complete, probe.reason, probe.count, probe.ok, clean]

solverSourceMinifiedParity()
    source = "probe = solver [x:[1,2,3], y:[1,2,3]] rules [x != y, x + y == 4] optimize [[max:x],[min:y]] mode " + char(34) + "all" + char(34) + " #"
    src = run(source)
    miniOut = run(mini(source))
    @ [
        src.reason == miniOut.reason,
        src.count == miniOut.count,
        src.best.x == miniOut.best.x,
        src.best.y == miniOut.best.y,
        src.solutions[1].x == miniOut.solutions[1].x
    ]

buildSolverPressureSource(varCount)
    q = char(34)
    nl = char(10)
    source = "probe = solver" + nl + "    [" + nl
    for i 1..varCount
        if i > 1 source += "," + nl #
        source += "        v" + i + ": [1, 2, 3, 4]"
    #
    source += nl + "    ]" + nl + "    rules [" + nl
    firstRule = true
    for i 1..varCount
        for j = i + 1 j <= varCount j += 1
            if firstRule != true source += "," + nl #
            source += "        v" + i + " != v" + j
            firstRule = false
        #
    #
    source += nl + "    ]" + nl
    source += "    mode " + q + "all" + q + nl
    source += "    limit 2000" + nl
    source += "    timeout 250" + nl
    source += "#"
    @ source

solverStackPressureRegression(varCount)
    source = buildSolverPressureSource(varCount)
    srcOk = passGuard(source)
    miniOk = passGuard(mini(source))
    @ [
        srcOk,
        miniOk,
        srcOk == miniOk
    ]

solverInFunctionStable(seed)
    makeProbe(extra)
        @ solver
            [
                x: [1, 2, 3],
                y: [1, 2, 3]
            ]
            rules [
                x + y == seed + extra
            ]
            optimize [
                [max: x]
            ]
        #
    probe = makeProbe(1)
    @ [probe.ok, probe.best.x, probe.best.y]

class SolverHarness
    in(seed)
        self.seed = seed
    @

    solve(extra)
        probe = solver
            [
                x: [1, 2, 3],
                y: [1, 2, 3]
            ]
            rules [
                x + y == self.seed + extra
            ]
            optimize [
                [max: y]
            ]
        #
        @ [probe.ok, probe.best.x, probe.best.y]
**

