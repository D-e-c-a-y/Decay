    assert("Vector Stepped Type", type(math_vec), "object")
    assert("Vector Stepped Val 1", math_vec[1], 10)
    assert("Vector Stepped Val 3", math_vec[3], 30)

    history = "DATA_STREAM_END"
    last_word = history.slice(-3, null)()
    assert("Negative Grab", last_word, "END")

    raw_data = [255, 0, 128]
    binary_buf = raw_data.slice(1, 3)(b)
    assert("Buffer Cast Type", type(binary_buf), "object")
    assert("Buffer Cast Val", binary_buf[3], 128)

    clean_mac = "AABBCC"
    blocks = clean_mac.chunk(2)()
    assert("Chunk Block Count", len(blocks), 3)
    assert("Chunk Block 1", blocks[1], "AA")

    dna = "GATTACA"
    codons = dna.chunk(3, 1)()
    assert("Crawler Block 1", codons[1], "GAT")
    assert("Crawler Block 2", codons[2], "ATT")

    packet = [255, 0, 10, 20, 30, 99]
    parts = packet.chunk([2, 3, 1])()
    assert("Pattern Chunk Parts", len(parts), 3)
    assert("Pattern Payload Len", len(parts[2]), 3)

    raw_signal = [1, 2, 3, 4]
    math_pairs = raw_signal.chunk(2)(v)
    assert("Chunk Vector Type", type(math_pairs[1]), "object")
    assert("Chunk Vector Data", math_pairs[2][2], 4)

    odd_data = "12345"
    trimmed = odd_data.chunk(2, null, "trim")()
    assert("Chunk Trim Policy", len(trimmed), 2)

    log = "ID:A01, SKIP, ID:B02"
    ids = log.chunk(["ID:", 3])()
    assert("Discovery Count", len(ids), 2)
    assert("Discovery Match 1", ids[1], "A01")
    assert("Discovery Match 2", ids[2], "B02")

    stream = "STARTDataA_STARTDataB_More"
    segments = stream.chunk(["START"])()
    assert("Range Count", len(segments), 2)
    assert("Range Match 1", segments[1], "DataA_")
    assert("Range Match 2 (EOF fallback)", segments[2], "DataB_More")

    bin_data = [0, 255, 0, 42, 0, 255, 0, 99]
    binary_payloads = bin_data.chunk([[255, 0], 1])()
    assert("Binary Seek Count", len(binary_payloads), 2)
    assert("Binary Seek Val", binary_payloads[1][1], 42)

    text = " Apple,  apple , Banana "
    counts = text.chunk([" ", null])(l t count)
    assert("Freq Map Type", type(counts), "arr")
    assert("Freq Count Apple", counts["apple"], 2)
    assert("Freq Count Banana", counts["banana"], 1)

    stepped = "X1X2X3X4"
    limited = stepped.chunk(["X", 1, 1, 2])()
    assert("Limit Check", len(limited), 2)
    assert("Skip Check", limited[2], "3")

    parts = "A:B:C:D".split(":", 2)()
    assert("Split Remainder Len", len(parts), 2)
    assert("Split Remainder Val", parts[2], "B:C:D")

    sieve = "A1B2C".split(/([0-9])/)()
    assert("Regex Sieve Len", len(sieve), 5)
    assert("Regex Sieve Token", sieve[2], "1")

    sauce = "A1B2C".split(/[0-9]/)()
    assert("Regex Sauce Len", len(sauce), 3)
    assert("Regex Sauce Val", sauce[2], "B")

    signal = [255, 10, 0, 255, 20, 0, 255, 30]
    frames = signal.split(0)(b)
    assert("Binary Split Count", len(frames), 3)
    assert("Binary Split Subarray Val", frames[2][2], 20)

    odd_data = "12345"
