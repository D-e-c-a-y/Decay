    profile = [name: "Tom", age: 30]
    profile += [city: "London", active: true]
    assert("Map += Preserve Name", profile.name, "Tom")
    assert("Map += Preserve Age", profile.age, 30)
    assert("Map += Add City", profile.city, "London")
    assert("Map += Add Active", profile.active, true)

    profile += [name: "Tim"]
    assert("Map += Collision Promotes Len", len(profile.name), 2)
    assert("Map += Collision First", profile.name[1], "Tom")
    assert("Map += Collision Second", profile.name[2], "Tim")

    profile += [name: "Tam"]
    assert("Map += Collision Append Len", len(profile.name), 3)
    assert("Map += Collision Third", profile.name[3], "Tam")
    assert("Map += Print Starts With Key", startsWith(__str(profile), "[^name"), true)

    queue = [1, 2]
    queue += [3, 4]
    assert("Array += Append 1", queue[3], 3)
    assert("Array += Append 2", queue[4], 4)
    assert("Array += Append Len", len(queue), 4)

    jObj = [id: 123, list: [1, 2]]
    jStr = json_str(jObj)
    jBack = json_parse(jStr)
    assert("JSON Roundtrip ID", jBack.id, 123)
    assert("JSON Roundtrip List", jBack.list[2], 2)

    myList = ["apple", "banana", "cherry", "banana"]
    assert("Array indexOf Found", myList.indexOf("banana"), 2)
    assert("Array indexOf Offset", myList.indexOf("banana", 3), 4)
    assert("Array indexOf Missing", myList.indexOf("grape"), -1)
    myList[](3)
    assert("Array indexOf Rebased Found", myList.indexOf("banana"), 4)
    assert("Array indexOf Rebased Offset", myList.indexOf("banana", 5), 6)
    assert("Array indexOf Rebased Missing", myList.indexOf("grape"), -1)

    delList = [10, 20, 30, 40, 50]
    removed = delList.splice(2, 3)
    assert("Splice Target Mutated", len(delList), 2)
    assert("Splice Target Result", delList[2], 50)
    assert("Splice Returned Array", removed[1], 20)
    assert("Splice Returned Len", len(removed), 3)

    insList = ["A", "D"]
    insList.splice(2, 0, "B", "C")
    assert("Splice Insertion Size", len(insList), 4)
    assert("Splice Insertion Val", insList[3], "C")

    fList = [1, 2, 3, 4, 5]
    fList.fill(99, 2, 4)
    assert("Fill Start Range", fList[2], 99)
    assert("Fill End Range", fList[3], 99)
    assert("Fill Boundary Kept", fList[4], 4)

    nums = [1, 2, 3, 4, 5]
    squares = nums.map(fn(x) @ x * x #)
    assert("Map Element 1", squares[1], 1)
    assert("Map Element 3", squares[3], 9)
    assert("Map Element 5", squares[5], 25)

    evens = nums.filter(fn(x) @ x % 2 == 0 #)
    assert("Filter Length", len(evens), 2)
    assert("Filter Element 1", evens[1], 2)
    assert("Filter Element 2", evens[2], 4)

    sum = 0
    nums.forEach(fn(x)
        sum += x
        @
    #)
    assert("forEach Side Effect Sum", sum, 15)

    idxSum = 0
    ["A", "B"].forEach(fn(val, idx)
        idxSum += idx
        @
    #)
    assert("forEach Index Passing", idxSum, 3)

    idxSum2 = 0
    ["X", "Y", "Z"].forEach(fn(val, idx)
        idxSum2 += idx
        @
    #)
    assert("Minifier Boundary (Assign + [)", idxSum2, 6)

    assert("Math PI", PI > 3.14 and PI < 3.15, true)
    assert("Math E", E > 2.71 and E < 2.72, true)
    assert("Math Infinity", INFINITY > 99999999999, true)

    vals = [2, 4, 6, 8]
    assert("Every (True)", vals.every(fn(x) @ x % 2 == 0 #), true)
    assert("Every (False)", vals.every(fn(x) @ x > 5 #), false)
    assert("Some (True)", vals.some(fn(x) @ x == 6 #), true)
    assert("Some (False)", vals.some(fn(x) @ x == 99 #), false)

    nums = [1, 2, 3, 4]
    sum = nums.reduce(fn(acc, curr) @ acc + curr #)
    assert("Reduce (No Init)", sum, 10)
    sumInit = nums.reduce(fn(acc, curr) @ acc + curr #, 100)
    assert("Reduce (With Init)", sumInit, 110)

    rbArr = ["A", "B", "C"]
    assert("Rebase Array Default[1]", rbArr[1], "A")
    rbArr[](0)
    assert("Rebase Array Override[0]", rbArr[0], "A")
    assert("Rebase Array Override[2]", rbArr[2], "C")

    rbArr2 = ["X", "Y", "Z"]
    assert("Rebase Scoped Read Array", rbArr2[1](0), "Y")
    rbArr2[2](0) = "Q"
    assert("Rebase Scoped Write Array", rbArr2[2](0), "Q")
    assert("Rebase Scoped No Mutation", rbArr2[1], "X")

    rbStr = "cat"
    assert("Rebase String Default[1]", rbStr[1], "c")
    s0 = rbStr[](0)
    assert("Rebase String View[0]", s0[0], "c")
    assert("Rebase String View[2]", s0[2], "t")

    assert("Rebase Scoped Read String", rbStr[1](0), "a")
    assert("Rebase Scoped Read String No Mutation", rbStr[1], "c")

print "\n=== 6. STRINGS, INTERPOLATION & TEXT PIPELINES ==="
    name = "World"
    num = 42
    msg = "Hello {name}, Answer: {num + 8}"
    assert("Interpolation", msg, "Hello World, Answer: 50")
    assert("Interpolation Stability", 1+1, 2)

    txt = "Hello DK World"
    assert("Has Literal /Hello/", has(txt, /Hello/), true)
    assert("Has String '^Hello'", has(txt, "^Hello"), true)

    m1 = match("abc 123", /[0-9]+/)
    m2 = match("abc 123", "[0-9]+")
    assert("Match Literal", m1[1], "123")
    assert("Match String",  m2[1], "123")

    squashLit = sub("a b c", /\s/, "")
    squashStr = sub("a b c", "\\s", "")
    assert("Squash Literal (/\s/)", squashLit, "abc")
    assert("Squash String ('\\s')", squashStr, "abc")

    assert("Flag Literal /dk/i", has(txt, /dk/i), true)
    assert("Flag String 'dk'", has(txt, "dk"), false)

    prefix = "Hel"
    pattern = "^" + prefix
    assert("Dynamic String Pattern", has(txt, pattern), true)

    str = "Hello"
    assert("UFCS Global Call", str.len(), 5)

    user = [name: "DK", age: 10]
    assert("UFCS Property", user.name, "DK")

    user.greet = fn(u) @ "Hi " + u.name
    assert("UFCS Method", user.greet(), "Hi DK")

    val = user.missingMethod()
    assert("Missing Method Returns Null", val, null)
    user.len = 99
    assert("UFCS Shadow Torture", user.len, 99)

    name = ^world
    assert("Sigil.upper()", name.upper(), "WORLD")
    assert("String.upper()", "hello".upper(), "HELLO")
    assert("Static upper()", upper(^hello), "HELLO")

    data = "apple-banana-cherry"
    parts = data.split(^-)
    assert("Sigil Split Len", len(parts), 3)
    assert("Sigil Split Val", parts[1], "apple")

    res = "v1v2".split(^v).join(2)
    assert("Numeric Coercion Chain", res, "2122")

    w = "A B".split(" ")
    assert("Quoted Delimiter", len(w), 2)

    raw = "  x.y.z  "
    pipeline = raw.trim().split(^.).join(^-)
    assert("Method Chaining", pipeline, "x-y-z")

    m = [^path: "usr/local/bin"]
    segments = m[^path].split(^/)
    assert("Regex Safety Split", segments[1], "usr")

    replaced = "hello world".replace(^world, ^dk)
    assert("Replace Native", replaced, "hello dk")

    assert("Char from Ord", char(102), "f")
    assert("Ord from Char", ord("f"), 102)
    mAt = match_at("hello world", "world", 6)
    assert("Match At Offset", mAt[0], "world")

    assert("indexOf Found", "hello world".indexOf("world"), 7)
    assert("indexOf Missing", "hello".indexOf("x"), -1)
    assert("indexOf Start Offset", "abc abc".indexOf("a", 2), 5)
    rebasedText = "hello world"[](3)
    assert("indexOf Rebased String Found", rebasedText.indexOf("world"), 9)
    assert("indexOf Rebased String Offset", rebasedText.indexOf("o", 7), 7)
    assert("indexOf Rebased String Missing", rebasedText.indexOf("x"), -1)
    assert("startsWith True", "DK Language".startsWith("DK"), true)
    assert("startsWith False", "DK Language".startsWith("Lang"), false)
    assert("endsWith True", "script.dk".endsWith(".dk"), true)
    assert("endsWith False", "script.dk".endsWith(".js"), false)

    assert("repeat String", "-".repeat(5), "-----")
    assert("repeat Zero", "x".repeat(0), "")
    assert("padStart Default", "5".padStart(3), "  5")
    assert("padStart Custom", "5".padStart(3, "0"), "005")
    assert("padEnd Default", "5".padEnd(3), "5  ")
    assert("padEnd Custom", "5".padEnd(3, "-"), "5--")
    assert("String Tool Chain", "dk".upper().padStart(5, "_").repeat(2), "___DK___DK")

print "\n=== 7. PARSER, LEXER, COMMENTS & MINIFIER INTEGRITY ==="
    assert("One Liner True", oneLine(5), 1)
    assert("One Liner False", oneLine(-5), 0)

    cVal = 10
    ~~ Block Comment ~~
    cVal += 10
    assert("Comments", cVal, 20)

    assert("Weird Spacing", spaced(5), 5)
    try x = 1 + err e print "[PASS] Syntax Recovery" #

    commaStr = "a, b, c"
    assert("Comma String Protection", commaStr, "a, b, c")
    print "[PASS] Space-Squeezed Print Test"

    loopCheck = 0
    for i=1 i<=3 i+=1
        loopCheck += i
    #
    assert("Auto-Swapped Loop Integrity", loopCheck, 6)

    sigilTest = fn(x) if x == 1 @ 10 # @ 20 #
    assert("Sigil Boundary Check", sigilTest(1), 10)

    tmark = 41
    ~ This line should be ignored tmark += 1
    tmark += 1
    assert("Tilde Line Comment (~)", tmark, 42)

    bmark = 5
    ~~ Any text here should be ignored: bmark = 999 ~~
    assert("Tilde Block Comment (~~ ~~)", bmark, 5)

    source = "fn main() @ 10"
    res = match(source, /^fn/)
    assert("Match Found", res != null, true)
    assert("Match Full Text", res.full, "fn")
    assert("Match Length", res.len, 2)
    assert("Match Index", res.index, 1)
    assert("Capture Group 0", res[1], "fn")

    code_f = ord(source, 1)
    code_paren = ord(source, 8)
    assert("Ord 'f'", code_f, 102)
    assert("Ord '('", code_paren, 40)
    assert("Ord Out of Bounds", ord(source, 100), null)

    pos = 1
    m = match(slice(source, pos), /^fn/)
    if m != null
        print "Found: " + m.full
        pos += m.len
    #
    if ord(source, pos) == 32
        print "Skipping space at " + str(pos)
        pos += 1
    #
    print "New Position: " + str(pos)
    assert("Cursor Advanced", pos, 4)

print "\n=== 8. MODULES, IMPORTS, CLASSES & OBJECT BEHAVIOUR ==="
    use modules/std/math
    assert("Import Math PI", math.pi, 3.14159)
    assert("Import Math Call", math.add(10,5), 15)

    use m = modules/std/math
    assert("Import Alias (m=)", m.pi, 3.14159)
    try use modules/std/void err e print "[PASS] Module Load Guard" #

    use modules/Animal
    myPet = Animal()
    sound = myPet.speak()
    print "Animal Instance: " + str(myPet)
    assert("Class Instance Type", type(myPet), "object")
    assert("Class Method Call", sound, "Woof!")

    use modules/testScript
    assert("Script Var x", testScript.x, 10)
    assert("Script Var y", testScript.y, 20)
    assert("Script Var sum", testScript.sum, 30)

    use modCapture = modules/suite_module_capture_helper
    modProbe = modCapture.build(7)
    assert("Module Exported Closure Capture", modProbe(5), 42)

    ** SwallowTest
        a() return 1 @
        b() return 10 @
    **
    t = SwallowTest()
    assert("Parser Swallow Check", t.a() + t.b(), 11)

    ** Grandparent
        id() return "GP" @
    **
    ** Parent : Grandparent
    **
    ** Child : Parent
    **
    c = Child()
    assert("Deep Inheritance", c.id(), "GP")

    ** Memory
        in() val = 0 @
        set(n) val = n @
        get() return val @
    **
    mObj = Memory()
    mObj.set(99)
    assert("Instance State", mObj.get(), 99)
    assert("Instance Stability (m.get)", mObj.get() == mObj.get(), true)

    ** Base
        in() baseVal = 500 @
    **
    ** Sub : Base
        in()
            {Base.in()}
            subVal = 100
        @
        check() return baseVal + subVal @
    **
    s = Sub()
    assert("Explicit Parent Call", s.check(), 600)
    assert("Parent Constructor Chain Probe", classParentChainProbe(), 60)

    overrideProbe = classOverrideChainProbe()
    assert("Method Override Root", overrideProbe[1], "root")
    assert("Method Override Mid", overrideProbe[2], "mid")
    assert("Method Override Leaf", overrideProbe[3], "mid")

    ** LocalClass
        check() @ "I am local"
    **
    lc = LocalClass()
    assert("Local Class Creation", lc.check(), "I am local")

    ** AliasCounter
        in(start)
            this.tally = start
            note = "ready"
        @
        bump()
            tally += 1
            @ this.tally
        @
        read()
            @ tally
        @
        readNote()
            @ this.note
        @
        nestedRead()
            inner() @ this.tally
            @ inner()
        @
    **
    counter = AliasCounter(5)
    assert("Class this alias write", counter.tally, 5)
    assert("Class optional field write", counter.readNote(), "ready")
    assert("Class optional compound assign", counter.bump(), 6)
    assert("Class optional field read", counter.read(), 6)
    assert("Class this alias nested read", counter.nestedRead(), 6)

    try s.subVal() err e print "[PASS] Method Lookup Guard" #

