print "\n=== 17. SOLVER BLOCK ==="
    solveFirst = solver
        [
            x: [1, 2],
            y: [1, 2, 3]
        ]
        rules [
            x != y,
            y < 3
        ]
    #
    assert("Solver First OK", solveFirst.ok, true)
    assert("Solver First Mode", solveFirst.mode, "first")
    assert("Solver First X", solveFirst.best.x, 1)
    assert("Solver First Y", solveFirst.best.y, 2)
    assert("Solver First Count", solveFirst.count, 1)
    assert("Solver First Reason", solveFirst.reason, "solved")

    solveBest = solver
        [
            x: [1, 2, 3],
            y: [1, 2, 3]
        ]
        rules [
            x != y
        ]
        optimize [
            [max: x + y],
            [min: abs(x - y)]
        ]
    #
    assert("Solver Optimize OK", solveBest.ok, true)
    assert("Solver Optimize X", solveBest.best.x, 2)
    assert("Solver Optimize Y", solveBest.best.y, 3)
    assert("Solver Optimize Hard", solveBest.score.hard, 1)

    solveAll = solver
        [
            a: [1, 2],
            b: [1, 2]
        ]
        rules [
            a != b
        ]
        mode "all"
    #
    assert("Solver All OK", solveAll.ok, true)
    assert("Solver All Mode", solveAll.mode, "all")
    assert("Solver All Count", solveAll.count, 2)
    assert("Solver All First A", solveAll.solutions[1].a, 1)
    assert("Solver All Second A", solveAll.solutions[2].a, 2)

    solveNone = solver
        [
            n: [1, 2]
        ]
        rules [
            n == 99
        ]
    #
    assert("Solver Unsat OK", solveNone.ok, false)
    assert("Solver Unsat Best", solveNone.best, null)
    assert("Solver Unsat Reason", solveNone.reason, "unsat")
    assert("Solver Unsat Count", solveNone.count, 0)

    solveKitchen = solver
        [
            a: [1, 2, 3, 4],
            b: [1, 2, 3, 4],
            c: [1, 2, 3, 4],
            d: [1, 2, 3, 4]
        ]
        rules [
            a != b,
            b != c,
            c != d,
            a != c,
            a != d,
            b != d,
            a + d == 5,
            b + c == 5
        ]
        prefer [
            a > d,
            b < c,
            a % 2 == 0
        ]
        optimize [
            [max: a],
            [min: d],
            [max: c]
        ]
        mode "all"
        limit 500
        timeout 2000
    #
    assert("Solver Kitchen OK", solveKitchen.ok, true)
    assert("Solver Kitchen Mode", solveKitchen.mode, "all")
    assert("Solver Kitchen Complete", solveKitchen.complete, true)
    assert("Solver Kitchen Reason", solveKitchen.reason, "solved")
    assert("Solver Kitchen Count", solveKitchen.count, 8)
    assert("Solver Kitchen Best A", solveKitchen.best.a, 4)
    assert("Solver Kitchen Best B", solveKitchen.best.b, 2)
    assert("Solver Kitchen Best C", solveKitchen.best.c, 3)
    assert("Solver Kitchen Best D", solveKitchen.best.d, 1)
    assert("Solver Kitchen Solutions Len", len(solveKitchen.solutions), 8)
    assert("Solver Kitchen Score Hard", solveKitchen.score.hard, 8)
    assert("Solver Kitchen Score Soft", solveKitchen.score.soft, 3)
    assert("Solver Kitchen Objective 1", solveKitchen.score.objectives[1], 4)
    assert("Solver Kitchen Objective 2", solveKitchen.score.objectives[2], -1)
    assert("Solver Kitchen Objective 3", solveKitchen.score.objectives[3], 3)
    assert("Solver Kitchen Tested", solveKitchen.tested >= solveKitchen.count, true)
    assert("Solver Kitchen Pruned", solveKitchen.pruned > 0, true)
    assert("Solver Kitchen Ranked First", solveKitchen.solutions[1].a, solveKitchen.best.a)

    logicSolve = solver
