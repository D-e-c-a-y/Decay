print "\n=== 13. NEURAL / AIAC / BRAIN FEATURES ==="
    hp = 20
    dist = 50
    rage = 10

    brain = neural boss_ai
        [hp, dist, rage]
        [20, any, any] Panic
        [80, 10, 90]   Enrage
        WITH [hp, dist, rage]
        limit 75
        case Panic    "Retreating"
        case Enrage   "Attacking"
        fallback     "Idle"
    #

    assert("Neural Winner", brain.last, "Panic")
    assert("Neural Confidence", brain.confidence >= 75, true)
    assert("Neural Action", brain.action, "Retreating")

    mood = brain
    assert("Alias Property Access", mood.last, "Panic")

    boss = Hydra(15, 90, 1)
    decision = boss.think()
    assert("Winner: Panic (Masked)", decision.last, "Panic")
    assert("Action: String Return", decision.action, "Regenerating")

    boss.hp = 80
    boss.dist = 5
    decision = boss.think()
    assert("Winner: Melee (Proximity)", decision.last, "Melee")
    assert("Action: Method Result", decision.action, "Crunch!")

    boss.hp = 50
    boss.dist = 50
    boss.heads = 2
    decision = boss.think()
    assert("Winner: Fallback", decision.last, "fallback")

    a = BrainTest(10, 0)
    b = BrainTest(0, 90)

    resA = a.getSpeed(0)
    assert("Instance A Winner", a.engine.last, "Slow")

    resB = b.getSpeed(0)
    assert("Instance B Winner", b.engine.last, "Fast")

    mathResult = a.getSpeed(100)
    assert("Neural Math Nesting", mathResult, 101)

    c = BrainTest(10, 90)
    c.getSpeed(0)
    assert("Tie-Breaker (First Definition)", c.engine.last, "Slow")
    assert("Confidence Stability", c.engine.confidence, 100)

