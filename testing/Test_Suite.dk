    listener = DKP_listen(^hold, fn(pulse)
        sourceSeen = pulse[^source]
        @
    #)
    packet = DKP_pack(^!!, "@ 77")
    sent = DKP_send(^hold, packet)
    removed = DKP_unlisten(listener)
    explicitOk = true
    try
        run(sourceSeen)
    err e
        explicitOk = false
    #
    @ [sent[^ok], executed, sourceSeen, explicitOk, removed]

dkpSelfExecutionProbe()
    seen = ""
    executed = false
    listener = DKP_listen(^selfrun, fn(pulse)
        seen = pulse[^source]
        run(seen)
        executed = true
        @
    #)
    packet = DKP_pack(^!!, "value = 40 + 2 @ value")
    sent = DKP_send(^selfrun, packet)
    removed = DKP_unlisten(listener)
    @ [sent[^ok], sent[^code], seen, executed, removed]

