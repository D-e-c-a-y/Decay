classParentChainProbe()
    ** RootChain
        in() rootVal = 10 @
    **
    ** MidChain : RootChain
        in()
            {RootChain.in()}
            midVal = 20
        @
    **
    ** LeafChain : MidChain
        in()
            {MidChain.in()}
            leafVal = 30
        @
        total() @ rootVal + midVal + leafVal
    **
    @ LeafChain().total()

