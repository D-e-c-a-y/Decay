    packet = DKP_pack(^!!, source)
    @ [packet, packet.indexOf(" = ") == -1, packet.indexOf(char(10)) == -1]

dkpUnpackProbe()
    pulse = DKP_unpack("?? [^msg:" + char(34) + "ack" + char(34) + "]")
    @ [pulse[^packet], pulse[^sigil], pulse[^source]]

dkpSendReceiveProbe()
    seen = []
    listener = DKP_listen(^local, fn(pulse)
        push(seen, pulse[^sigil] + "|" + pulse[^source] + "|" + pulse[^channel])
        @
    #)
    packet = DKP_pack(^!!, "done = 7")
    sent = DKP_send(^local, packet)
    removed = DKP_unlisten(listener)
    @ [sent[^ok], sent[^code], sent[^channel], len(seen), seen[1], removed]

dkpUnlistenProbe()
    seen = []
    listener = DKP_listen(^solo, fn(pulse)
        push(seen, pulse[^packet])
        @
    #)
    first = DKP_send(^solo, DKP_pack(^!!, "done = 1"))
    removed = DKP_unlisten(listener)
    removedAgain = DKP_unlisten(listener)
    bad = captureRunError("DKP_send(^solo, DKP_pack(^!!, " + char(34) + "done = 2" + char(34) + "))")
    @ [first[^ok], len(seen), removed, removedAgain, bad[2], bad[3]]

