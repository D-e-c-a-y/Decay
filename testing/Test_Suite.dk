        for j = 1 j <= 10 j += 1
            if j == 3 continue #
            if j == 5 break #
            count += 1
        #
    #
    @ count

makeMultiplier(factor):
    multiply(n):
        @ n * factor
    @ multiply

makeCounter():
    count = 0
    increment():
        count = count + 1
        @ count
    @ increment

makeAdder(x):
    add(y):
        @ x + y
    @ add

shadowOuter():
    a = "outer"
    inner():
        @ a
    @ inner

makeLocalClassFactory(seed):
    ** LocalSeed
        in(add) val = seed + add @
        get() @ val
    **
    @ LocalSeed

