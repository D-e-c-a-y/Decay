print "\n=== 11. BUFFERS, VECTORS & LINEAR ALGEBRA ==="
    mem = buffer(4, "f32")
    mem[1] = 3.14
    mem[2] = 42
    mem[3] = 99.9
    assert("Buffer Allocation Len", len(mem), 4)
    assert("Buffer Read 1-Base", mem[2], 42)
    isFloat32 = mem[1] > 3.14 and mem[1] < 3.15
    assert("Buffer Float32 Precision", isFloat32, true)
    assert("Buffer OOB Read", mem[99], null)

    memBuf = buffer(100, "f32")
    memBuf.fill(3.14)
    isPi = memBuf[50] > 3.13 and memBuf[50] < 3.15
    assert("Buffer Fill Support", isPi, true)

    rbBuf = buffer(4, "f32")
    rbBuf[1] = 11
    rbBuf[2] = 22
    assert("Rebase Buffer Default[1]", rbBuf[1], 11)
    assert("Rebase Buffer Default[2]", rbBuf[2], 22)

    rbBuf[](0)
    assert("Rebase Buffer Override[0]", rbBuf[0], 11)
    assert("Rebase Buffer Override[1]", rbBuf[1], 22)

    rbBuf2 = buffer(4, "f32")
    rbBuf2[2](0) = 99
    assert("Rebase Scoped Write Buffer", rbBuf2[2](0), 99)
    assert("Rebase Scoped Read Buffer No Mutation", rbBuf2[1], 0)

    assert("Rebase Len String Count", len(rbStr), 3)
    assert("Rebase Len String View Count", len(s0), 3)
    assert("Rebase Len Buffer Count", len(rbBuf), 4)

    pos|[10.5, 20.1, 30.2]
    assert("Vector Type Check", type(pos), "object")
    assert("Vector Index Read", pos[1], 10.5)
    pos[1] = 99
    assert("Vector Index Write", pos[1], 99)

    temp = 100
    humidity = 50
    neural sensor_logic
        WITH [temp, humidity]
        limit 80
        case HighHeat [100, any]
        case Humid    [any, 90]
    #
    res = sensor_logic()#
    assert("Neural Vector Winner", res[^last], "HighHeat")
    assert("Neural Vector Confidence", res[^confidence], 100)

    v1 = |[3, 4]
    v2 = |[1, 2]
    assert("Vector Add", vec_add(v1, v2)[1], 4)
    assert("Vector Sub", vec_sub(v1, v2)[2], 2)
    assert("Vector Mag", vec_mag(v1), 5)

    norm = v1.vec_scale(2).vec_norm()
    assert("Vector Chain", norm[1] > 0.59 and norm[1] < 0.61, true)

    input_state = |[10.0, 5.0]
    weights = [
        |[ 0.5, -0.2,  0.1],
        |[-0.1,  0.8, -0.5]
    ]
    logits = input_state.mat_mul(weights)
    assert("Matrix Mul [1]", logits[1], 4.5)
    assert("Matrix Mul [2]", logits[2], 2.0)
    assert("Matrix Mul [3]", logits[3], -1.5)

    probs = logits.vec_softmax()
    p1 = round(probs[1] * 100)
    p2 = round(probs[2] * 100)
    p3 = round(probs[3] * 100)

    assert("Softmax P1 (~92%)", p1, 92)
    assert("Softmax P2 (~8%)", p2, 8)
    assert("Softmax P3 (~0%)", p3, 0)
    assert("Softmax Sum Check", p1 + p2 + p3, 100)

