print "\n=== 14. SENSORY RESTRUCTURING FAMILY ==="
    pulse = "SENSORY"
    picked = pulse.slice([1, 3, 5])(f)
    assert("Multi-Pick Flat", picked, "SNO")

    signal = [10, 255, 20, 255, 30, 255]
