failCount = 0
__str = str
__suite_start_ms = clock()
__tracked_sleep_ms = 0
__tracked_fetch_ms = 0
__tracked_fetch_count = 0

assert(name, value, expected)
    if value == expected print "[PASS] " + name #
    if value != expected
        failCount += 1
        print "[FAIL] " + name + " | Want: " + __str(expected) + ", Got: " + __str(value) 
    #
    @

trackedSleep(ms)
    __tracked_sleep_ms += ms
    sleep(ms)
@

trackedFetchText(url)
    started = clock()
    res = fetch_text(url)
    took = clock() - started
    if took < 0 took = 0 #
    __tracked_fetch_ms += took
    __tracked_fetch_count += 1
    @ res

