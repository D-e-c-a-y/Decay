print "\n=== 15. REGRESSIONS & PATHOLOGICAL BEHAVIOUR ==="
    deepData = [0, 1]
    deepData[1] = [:]
    deepData[1].target = [100, 200]
    val = deepData[1].target[2]
    assert("Deep Access Chain", val, 200)

    key = "dynamicVal"
    container = [:]
    container[key] = "Success"
    readBack = container[key]
    assert("Dynamic Key Write/Read", readBack, "Success")
    assert("Dynamic Key Shadow Check", container.key, null)

    bitAnd = 5 & 1
    assert("Bitwise AND (&)", bitAnd, 1)
    bitOr = 5 | 2
    assert("Bitwise OR (|)", bitOr, 7)

    coerced = 10 + " apples"
    assert("Type Coercion (Num -> Str)", coerced, "10 apples")
    assert("Deep Access Torture", deepData[99].bad, null)

    class AliasBase
        ping() @ "BASE"
    class

    class AliasChild : AliasBase
    class

    ach = AliasChild()
    assert("class/class Inheritance Alias", ach.ping(), "BASE")

    function makeStep(start)
        cur = start
        next():
            cur += 1
            @ cur
        @ next

    try
        step = makeStep(10)
        assert("function Nested Closure 1", step(), 11)
        assert("function Nested Closure 2", step(), 12)
    err e
        failCount += 1
        print "[FAIL] function Nested Closure (guard) | " + e[^msg]
    #

    leakedLocalClass = false
    try
        LocalSeed()
    err e
        leakedLocalClass = true
    #
    assert("Local Class Not Global", leakedLocalClass, true)

    assert("Switch Num Match", switchTest(1), "One")
    assert("Switch Str Match", switchTest("A"), "Alpha")
    assert("Switch Default", switchTest(999), "Default")

    nestedSwitch = 0
    switch 1
        case 1
            switch 2
                case 2
                    nestedSwitch = 200
                default
                    nestedSwitch = 404
            #
        case 2
            nestedSwitch = 500
    #
    assert("Nested Switch Logic", nestedSwitch, 200)

    bVal = 0
    i = 1
    for i <= 10
        if i == 4 break #
        bVal = i
        i += 1
    #
    assert("Conditional Loop Break", bVal, 3)

    cVal = 0
    j = 0
    for j < 5
        j += 1
        if j == 3 continue #
        cVal += 1
    #
    assert("Conditional Loop Continue", cVal, 4)

    rSum = 0
    for k 1..5
        if k == 3 continue #
        rSum += k
    #
    assert("Range Loop Continue", rSum, 12)

    assert("Deep Loop Control Stress", nestedControlTest(), 9)
    cap = nestedCatchClosureCapture()
    assert("Nested Catch Closure Msg", cap[1], "boom")
    assert("Nested Catch Closure Code", cap[2], 77)
    assert("Loop Continue Nested Factory", loopContinueNestedFactory(), 52)
    assert("Loop Break Nested Factory", loopBreakNestedFactory(), 12)
    assert("Nested Rebase View Closure", nestedRebaseViewClosure(), "t")

    sbVal = 0
    switch 10
        case 10
            sbVal = 1
        case 20
            sbVal = 2
    #
    assert("Switch Auto-Break (No Fallthrough)", sbVal, 1)

    assert("Guard: Continue Outside Loop", testGuard("continue"), true)
    assert("Guard: Break Outside Loop", testGuard("break"), true)
    assert("Guard: Case Outside Switch", testGuard("case 10"), true)

    f = fn(x) @ x + 1 #
    g = fn(x) @ f(x) + f(x + 1) #
    assert("Stack Align 1", g(1), 5)

    t = 0
    try
        t = 10
        throw "fail"
        t = 99
    err e
        t += 1
    #
    assert("Try Restore", t, 11)

    if true
        rec2(n): if n <= 0 @ 0 # @ rec2(n-1)
        assert("Nested Recursion", rec2(5), 0)
    #

    add(a, b): @ a + b + 100
    assert("Local Shadow Override", add(1, 2), 103)

    m = [f: fn(x) @ x + 1 #]
    assert("Obj Method Call", m.f(1), 2)
    try f(1) err e print "[PASS] Method Not Global" #

    f = fn(x) @ x #
    f = 123
    try f() err e print "[PASS] Rebind Non-Callable" #

    base = 5
    inc(n): @ n + base
    assert("Implicit Upvalue Capture", inc(1), 6)

print "\n=== 16. LOOP ORDER-INSENSITIVITY REGRESSIONS ==="
    orderWhile():
        i = 0
        s = 0
        for i < 4
            i += 1
            s += i
        #
        @ s

    orderRange():
        s = 0
        for i 1..4
            s += i
        #
        @ s

    orderRangeStep():
        s = 0
        for i 1..9 i += 2
            s += i
        #
        @ s

    orderContinue():
        i = 0
        s = 0
        for i < 6
            i += 1
            if i == 3 continue #
            s += i
        #
        @ s

    orderBreak():
        i = 0
        s = 0
        for i < 10
            i += 1
            if i == 5 break #
            s += i
        #
        @ s

    orderSentinel():
        token = "A"
        guard = 0
        for token != "EOF" and guard < 10
            guard += 1
            if guard == 2 token = "MID" #
            if guard == 4 token = "EOF" #
        #
        @ guard

    orderNestedControl():
        total = 0
        for i 1..3
            switch i
                case 2
                    continue
                default
                    total += i
            #
        #
        @ total

    loopInsideFn():
        total = 0
        inner(n):
            for i 1..n
                total += i
            #
            @ total
        @ inner(3)

    makeLoopClosure():
        for i 1..1
            nested():
                @ 7
            @ nested
        #
        @ fn() @ 0 #

    assert("Order A While", orderWhile(), 10)
    assert("Order A Range", orderRange(), 10)
